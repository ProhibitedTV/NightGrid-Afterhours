; NIGHTGRID: AFTERHOURS — original open-world prototype
config_version=5

[application]
config/name="NIGHTGRID: AFTERHOURS"
run/main_scene="res://scenes/studio_intro.tscn"
# Rendering is not capped by fixed-step physics.
run/max_fps=0
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]
GameSession="*res://scripts/game_session.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
# Keep the original Windows Forward+ Vulkan baseline for the F10 screenshots.
# New 4.6+ projects default to D3D12; evaluate that separately with F8 traces.
rendering_device/driver.windows="vulkan"
renderer/rendering_method.mobile="gl_compatibility"
environment/screen_space_reflection/half_size=true
environment/defaults/default_clear_color=Color(0.04, 0.05, 0.09, 1)

[physics]
# Gameplay simulation runs at fixed 60Hz, independent of display refresh.
common/physics_ticks_per_second=60
# Preserve established Godot 4.3 vehicle/player collision response. Godot
# 4.6+ may default new projects to Jolt; port physics separately if desired.
3d/physics_engine="GodotPhysics3D"
3d/default_gravity=24.0

[shader_globals]
cinder_surface_film={
"type": "float",
"value": 0.0
}
