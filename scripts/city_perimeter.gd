extends Node3D
## Permanent authored Morrow Bay perimeter. The city grid remains 8x8 and
## save-stable; beyond its final roads are port water, hills and industrial land.
## Gameplay collision is a visible, solid road boundary, never a fade/teleport.
const WorldPlan = preload("res://scripts/world_plan.gd")
const Materials = preload("res://scripts/material_library.gd")
const EDGE = WorldPlan.GRID_RADIUS * WorldPlan.BLOCK_SIZE + 13.5
const SPAN = 492.0
const ROAD_STEP = WorldPlan.BLOCK_SIZE
const HarborShader = preload("res://shaders/harbor_water.gdshader")
var _harbor_material: ShaderMaterial

var _stats := {"barriers": 0, "road_gates": 0, "sea_surfaces": 0, "landscapes": 0,
	"port_piers": 0, "industrial_landmarks": 0}

func get_perimeter_stats() -> Dictionary:
	return _stats.duplicate()

func _ready() -> void:
	# This permanent scene is not regenerated by district streaming or save load.
	_build_seawater()
	_build_eastern_ridges()
	_build_southworks_outskirts()
	_build_port_infrastructure()
	_build_physical_edges()
	_build_road_terminals()

func _box(label: String, position: Vector3, dimensions: Vector3,
		surface: String, tint: Color) -> MeshInstance3D:
	var node := MeshInstance3D.new()
	node.name = label
	var mesh := BoxMesh.new()
	mesh.size = dimensions
	node.mesh = mesh
	node.position = position
	node.material_override = Materials.surface(surface, tint)
	add_child(node)
	return node

func _solid_edge(label: String, position: Vector3, dimensions: Vector3,
		surface: String, tint: Color) -> void:
	var body := StaticBody3D.new()
	body.name = label
	body.collision_layer = 1
	body.collision_mask = 1
	body.position = position
	var collision := CollisionShape3D.new()
	var shape := BoxShape3D.new()
	shape.size = dimensions
	collision.shape = shape
	body.add_child(collision)
	var visible := MeshInstance3D.new()
	visible.name = "CollisionMatchedBulkhead"
	var mesh := BoxMesh.new()
	mesh.size = dimensions
	visible.mesh = mesh
	visible.material_override = Materials.surface(surface, tint)
	body.add_child(visible)
	add_child(body)
	_stats["barriers"] += 1

func _water(name_value: String, center: Vector3, surface_size: Vector2) -> void:
	var sea := MeshInstance3D.new()
	sea.name = name_value
	var plane := PlaneMesh.new()
	plane.size = surface_size
	plane.subdivide_width = 6
	plane.subdivide_depth = 6
	sea.mesh = plane
	sea.position = center
	if _harbor_material == null:
		_harbor_material = ShaderMaterial.new()
		_harbor_material.shader = HarborShader
		_harbor_material.set_shader_parameter("quay_edge",EDGE+0.5)
	sea.material_override = _harbor_material
	sea.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	add_child(sea)
	_stats["sea_surfaces"] += 1

func _build_seawater() -> void:
	# Ground/roads terminate near +/-245; water starts *outside* the quay,
	# rather than sitting over concrete or disappearing into the world void.
	# Partition the L-shaped harbor at z=-246 instead of overlapping two
	# coplanar planes across the northwest corner (depth fighting).
	_water("NorthQuay_OpenHarbor", Vector3(-85.0, -0.56, -658.0),
		Vector2(1970.0, 824.0))
	_water("WestDocks_OpenHarbor", Vector3(-658.0, -0.56, 327.0),
		Vector2(824.0, 1146.0))
	# Breakwater foam and tidelines make the transition readable at street
	# level; avoid expensive per-frame wave meshes or screen-space reflections.
	for index in range(12):
		var t := float(index) / 11.0
		var x := lerpf(-245.0, 245.0, t)
		var z := lerpf(-245.0, 245.0, t)
		_box("NorthQuay_Tideline_%02d" % index,
			Vector3(x, -0.51, -249.2 - float(index % 3) * 0.7),
			Vector3(31.0, 0.018, 0.17), "WET", Color("517f84"))
		_box("WestDocks_Tideline_%02d" % index,
			Vector3(-249.3 - float(index % 3) * 0.7, -0.51, z),
			Vector3(0.17, 0.018, 31.0), "WET", Color("517f84"))

func _elevation(x: float, z: float) -> float:
	var ratio := clampf((x - EDGE) / 490.0, 0.0, 1.0)
	var ridge := 32.0 + 16.0 * sin(z * 0.013) + 9.0 * sin(z * 0.037)
	return -0.08 + pow(ratio, 1.3) * maxf(15.0, ridge)

func _build_eastern_ridges() -> void:
	# A single low-poly terrain mesh, not 200 terrain-collider blocks.
	# Its height rises gradually into Horizon Gardens' wooded hills beyond
	# the eastern transport/road barrier and merges with atmospheric fog.
	var surface := SurfaceTool.new()
	surface.begin(Mesh.PRIMITIVE_TRIANGLES)
	var rows := 30
	var bands := 10
	for x_index in range(bands):
		var x0 := EDGE + float(x_index) * 54.0
		var x1 := EDGE + float(x_index + 1) * 54.0
		for z_index in range(rows):
			var z0 := -810.0 + float(z_index) * 54.0
			var z1 := z0 + 54.0
			var a := Vector3(x0, _elevation(x0, z0), z0)
			var b := Vector3(x1, _elevation(x1, z0), z0)
			var c := Vector3(x1, _elevation(x1, z1), z1)
			var d := Vector3(x0, _elevation(x0, z1), z1)
			# Clockwise is the visible front in Godot 4.3; keep hills facing UP.
			for vertex in [a, b, c, a, c, d]:
				surface.set_uv(Vector2(vertex.x * 0.03, vertex.z * 0.03))
				surface.add_vertex(vertex)
	surface.generate_normals()
	var hill := MeshInstance3D.new()
	hill.name = "HorizonGardens_DistantRidgeland"
	hill.mesh = surface.commit()
	hill.material_override = Materials.surface("CONCRETE", Color("3e5049"))
	hill.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	add_child(hill)
	_stats["landscapes"] += 1

func _build_southworks_outskirts() -> void:
	# Southern industrial lots continue into fog behind the visible security
	# wall. A grounded freight yard replaces otherwise unsupported asphalt.
	_box("Southworks_FreightYard", Vector3(0.0, -0.45, 602.0),
		Vector3(1400.0, 0.8, 710.0), "CONCRETE", Color("343d41"))
	_stats["landscapes"] += 1
	for index in range(9):
		var x := -350.0 + float(index) * 89.0
		var z := 319.0 + float(index % 3) * 64.0
		var height := 16.0 + float((index * 7) % 4) * 7.0
		_box("Southworks_BackgroundDepot_%02d" % index,
			Vector3(x, height * 0.5, z),
			Vector3(59.0, height, 48.0), "METAL", Color("485257"))
		_box("Southworks_DepotRoof_%02d" % index,
			Vector3(x, height + 0.35, z),
			Vector3(63.0, 0.7, 53.0), "METAL", Color("232d36"))
		_stats["industrial_landmarks"] += 1
	for index in range(4):
		var x := -220.0 + float(index) * 141.0
		var cylinder := MeshInstance3D.new()
		cylinder.name = "Southworks_StorageTank_%02d" % index
		var tank := CylinderMesh.new()
		tank.top_radius = 9.5
		tank.bottom_radius = 10.2
		tank.height = 17.0 + float(index % 3) * 3.0
		tank.radial_segments = 18
		cylinder.mesh = tank
		cylinder.position = Vector3(x, tank.height * 0.5, 480.0)
		cylinder.material_override = Materials.surface("METAL", Color("68716e"))
		add_child(cylinder)
		_stats["industrial_landmarks"] += 1

func _build_port_infrastructure() -> void:
	# Working harbor: fixed piers, pilings and crane gantries beyond the
	# playable seawall. These are skyline props with no gameplay collisions.
	for index in range(4):
		var x := -185.0 + float(index) * 113.0
		_box("NorthQuay_PierDeck_%02d" % index, Vector3(x, -0.14, -325.0),
			Vector3(11.5, 0.6, 142.0), "METAL", Color("5d6567"))
		for pile in range(4):
			_box("NorthQuay_Pile_%d_%d" % [index, pile],
				Vector3(x + (-4.2 if pile % 2 == 0 else 4.2), -2.8,
					-276.0 - float(int(pile / 2)) * 89.0),
				Vector3(1.1, 5.9, 1.1), "CONCRETE", Color("555c5a"))
		_gantry("NorthQuay_Crane_%02d" % index,
			Vector3(x, 0.0, -368.0), 32.0 + float(index % 2) * 9.0)
		_stats["port_piers"] += 1
	for index in range(3):
		var z := -169.0 + float(index) * 162.0
		_box("WestDocks_PierDeck_%02d" % index, Vector3(-325.0, -0.14, z),
			Vector3(142.0, 0.6, 11.5), "METAL", Color("575e61"))
		_gantry("WestDocks_Crane_%02d" % index,
			Vector3(-372.0, 0.0, z), 34.0)
		_stats["port_piers"] += 1

func _gantry(name_value: String, anchor: Vector3, height: float) -> void:
	var steel := Color("62675f")
	_box(name_value + "_Tower", anchor + Vector3(0.0, height * 0.5, 0.0),
		Vector3(2.1, height, 2.2), "METAL", steel)
	_box(name_value + "_Jib", anchor + Vector3(12.0, height, 0.0),
		Vector3(31.0, 1.7, 2.1), "METAL", steel)
	_box(name_value + "_Counterweight", anchor + Vector3(-5.8, height + 0.5, 0.0),
		Vector3(9.0, 3.1, 4.0), "METAL", Color("444d55"))
	_box(name_value + "_Cable", anchor + Vector3(22.0, height - 8.0, 0.0),
		Vector3(0.15, 16.0, 0.15), "METAL", Color("222c32"))

func _build_physical_edges() -> void:
	# Four real collision walls along the LAST authored street. Each collision
	# volume matches a clearly visible continuous wall: players and vehicles
	# cannot drive toward the ocean or unsupported land.
	var north := Vector3(0.0, 0.89, -EDGE)
	var west := Vector3(-EDGE, 0.89, 0.0)
	var east := Vector3(EDGE, 0.89, 0.0)
	var south := Vector3(0.0, 0.89, EDGE)
	_solid_edge("NorthQuay_QuaySafetyWall", north, Vector3(SPAN, 1.98, 1.4),
		"CONCRETE", Color("69757a"))
	_solid_edge("WestDocks_QuaySafetyWall", west, Vector3(1.4, 1.98, SPAN),
		"CONCRETE", Color("626b71"))
	_solid_edge("HorizonGardens_HillsideSoundwall", east,
		Vector3(1.4, 1.98, SPAN), "CONCRETE", Color("596967"))
	_solid_edge("Southworks_SecurityWall", south,
		Vector3(SPAN, 1.98, 1.4), "CONCRETE", Color("59616a"))
	# Crown rails and repeated steel uprights visibly reinforce the industrial
	# quay and city boundary, without 100s of individual physics bodies.
	for side in ["NORTH", "WEST", "EAST", "SOUTH"]:
		var cross: bool = side == "NORTH" or side == "SOUTH"
		var fixed: float = -EDGE if side == "NORTH" or side == "WEST" else EDGE
		var rail_position := Vector3(0.0, 1.98, fixed) if cross else Vector3(fixed, 1.98, 0.0)
		_box(side + "_PerimeterCrown", rail_position,
			Vector3(SPAN, 0.14, 0.17) if cross else Vector3(0.17, 0.14, SPAN),
			"METAL", Color("778789"))
		var posts := MultiMesh.new()
		posts.transform_format = MultiMesh.TRANSFORM_3D
		var post_mesh := BoxMesh.new()
		post_mesh.size = Vector3.ONE
		posts.mesh = post_mesh
		posts.instance_count = 29
		for index in range(29):
			var offset := -238.0 + float(index) * 17.0
			var at := Vector3(offset, 1.25, fixed) if cross else Vector3(fixed, 1.25, offset)
			posts.set_instance_transform(index, Transform3D(Basis().scaled(Vector3(0.23, 2.5, 0.23)), at))
		var posts_node := MultiMeshInstance3D.new()
		posts_node.name = side + "_GuardrailUprights"
		posts_node.multimesh = posts
		posts_node.material_override = Materials.surface("METAL", Color("58696e"))
		add_child(posts_node)

func _build_road_terminals() -> void:
	for side in ["NORTH", "SOUTH", "EAST", "WEST"]:
		var cross: bool = side == "NORTH" or side == "SOUTH"
		var edge_coordinate: float = -EDGE if side == "NORTH" or side == "WEST" else EDGE
		for index in range(-WorldPlan.GRID_RADIUS, WorldPlan.GRID_RADIUS + 1):
			var axis := float(index) * ROAD_STEP
			var center := Vector3(axis, 0.08, edge_coordinate - 2.8) if cross else Vector3(edge_coordinate - 2.8, 0.08, axis)
			if side == "WEST":
				center.x = edge_coordinate + 2.8
			# Physical closure already spans the entire road. Yellow/black
			# approaches warn drivers and turn the last junction into a
			# recognizably restricted harbor, hillside or freight endpoint.
			for mark in range(5):
				var offset := (float(mark) - 2.0) * 2.15
				var at := center + (Vector3(offset, 0.0, 0.0) if cross else Vector3(0.0, 0.0, offset))
				_box("%s_RoadEndChevron_%d_%d" % [side, index, mark],
					at, Vector3(0.82, 0.045, 0.90), "PAVERS", Color("d0a34b"))
			_stats["road_gates"] += 1
