# Voice provenance hashes cover exact JSON bytes; keep LF on all platforms.
assets/audio/voiced/**/take.json text eol=lf
assets/audio/voiced/**/qc.json text eol=lf
assets/audio/voiced/**/review.json text eol=lf
tools/voice/cast-library/**/*.json text eol=lf
tools/voice/model-pins.json text eol=lf
*.wav binary

# WSL launcher must not receive CRLF on Windows checkout.
*.sh text eol=lf
*.cmd text eol=crlf
assets/audio/generated/synaxis/*.json text eol=lf
